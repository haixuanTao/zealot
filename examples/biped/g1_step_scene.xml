<mujoco model="g1 step scene">
  <!-- The playground flat scene plus ONE step: a 10 cm platform whose front
       face is a clean edge across the robot's path at x = 1.5 m. Built for
       the step-crossing eval (sim2sim_g1_mujoco.py with S2S_STEP_EDGE_X /
       S2S_STEP_H): the harness computes the step cue from this known
       geometry, so the eval measures STEP EXECUTION, not perception.
       Feet-only collision like the parent scene, so the step needs its own
       explicit contact pairs. -->
  <include file="/home/champagne/rt_build/bench-venv/lib/python3.12/site-packages/mujoco_playground/_src/locomotion/g1/xmls/g1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.7" extent="1.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <global azimuth="140" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"/>
    <!-- Step platform: front face at x = 1.5 (edge), top at z = STEP_H. The
         box is long enough (4 m) that the far side never matters in a 15 s
         clip, and full strip width so oblique approaches still land on it.
         Height set for a 0.10 m step; the eval scales difficulty by editing
         size/pos in a tempfile (see the harness), so treat these numbers as
         the DEFAULT, not the contract. -->
    <geom name="step" type="box" pos="3.5 0 0.05" size="2.0 3.0 0.05" rgba="0.8 0.3 0.2 1"/>
  </worldbody>

  <contact>
    <pair name="left_foot_step" geom1="left_foot" geom2="step" condim="3" friction="0.6 0.6"/>
    <pair name="right_foot_step" geom1="right_foot" geom2="step" condim="3" friction="0.6 0.6"/>
  </contact>

  <include file="/home/champagne/rt_build/bench-venv/lib/python3.12/site-packages/mujoco_playground/_src/locomotion/g1/xmls/sensor.xml"/>

  <keyframe>
    <key name="home"
      qpos="
      0 0 0.785
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "
      ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
  </keyframe>
</mujoco>
